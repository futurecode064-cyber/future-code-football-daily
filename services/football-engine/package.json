{
  "name": "future-code-football-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dev:local": "wrangler dev --config wrangler.local.jsonc",
    "check:bundle": "wrangler deploy --dry-run --config wrangler.local.jsonc --outdir .wrangler/dry-run",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "test:runtime": "node tests/runtime-smoke.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "miniflare": "5.20261019.1-beta",
    "wrangler": "4.151.3"
  }
}
