{
  "name": "future-code-football-engine-staging",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "vars": {"ALLOWED_ORIGINS":"https://future-code-football-daily.pages.dev","ENVIRONMENT":"staging"},
